# ============================================
# Agentic RAG — Environment Configuration
# Salin file ini menjadi .env lalu sesuaikan
# ============================================

APP_ENV=development
APP_NAME=Agentic RAG
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_DB=agentic_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:mysecretpassword@localhost:5432/agentic_rag

# User read-only khusus SQL Agent (PRD §18 - Database Security)
SQL_AGENT_DB_USER=rag_readonly
SQL_AGENT_DB_PASSWORD=readonlypassword
SQL_AGENT_DATABASE_URL=postgresql+psycopg://rag_readonly:readonlypassword@localhost:5432/agentic_rag
SQL_AGENT_ALLOWED_TABLES=chat_history,documents,pegawai,pengajuan_cuti
SQL_AGENT_QUERY_TIMEOUT=10
SQL_AGENT_MAX_ROWS=100

# --- Provider AI ---------------------------------------------------------
# Ollama adalah satu-satunya penyedia LLM dan embedding, sesuai PRD §4.2.
#
#   LLM_PROVIDER        : ollama
#   EMBEDDING_PROVIDER  : ollama | hash_stub
#
# hash_stub adalah embedding deterministik lokal khusus pengembangan: memakai
# hashing, bukan model, sehingga pipeline RAG (chunking -> simpan -> pencarian
# pgvector) bisa diuji tanpa model apa pun. Kualitas semantiknya rendah dan
# TIDAK boleh dipakai untuk menilai mutu retrieval.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://172.28.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192

# Dimensi harus cocok dengan embedding model (nomic-embed-text = 768)
EMBEDDING_DIM=768

# --- RAG ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=4

# Potongan yang skornya jauh di bawah potongan terbaik dibuang sebelum
# dikirim ke LLM. Ambangnya relatif (0.5 = setengah skor terbaik), bukan
# angka mati, karena tiap model embedding punya rentang skor sendiri.
# Isi 0 untuk mematikan penyaringan.
RAG_MIN_SCORE_RATIO=0.5

# Potongan dokumen yang memuat pola pengambilalihan peran ("abaikan semua
# instruksi", "kamu sekarang adalah ...") disingkirkan dari hasil pencarian,
# sehingga tidak pernah sampai ke model (PRD §18).
RAG_QUARANTINE_SUSPICIOUS=true

# Hybrid search (PRD §25): hasil pencarian vektor digabung dengan pencarian
# teks penuh PostgreSQL memakai Reciprocal Rank Fusion. Berguna terutama
# untuk bahasa Indonesia, tempat model embedding lemah memisahkan makna
# sementara pencocokan istilah justru bekerja baik.
RAG_HYBRID_ENABLED=true
RAG_FTS_LANGUAGE=indonesian
RAG_RRF_K=60
# Bobot tiap jalur saat digabung. Teks penuh diberi bobot lebih besar
# karena terbukti lebih andal pada dokumen berbahasa Indonesia.
RAG_BOBOT_VEKTOR=1.0
RAG_BOBOT_TEKS=2.0

# --- File Upload (PRD §18 - File Upload Security) ---
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
MAX_UPLOAD_SIZE_MB=20
ALLOWED_DOC_EXTENSIONS=.pdf,.txt,.md
ALLOWED_IMAGE_EXTENSIONS=.png,.jpg,.jpeg,.webp

# --- OCR ---
OCR_LANG=en
OCR_USE_GPU=false

# --- Security ---
# Matikan (false) untuk melewati autentikasi saat mengembangkan di mesin
# sendiri. Seluruh permintaan lalu dianggap datang dari admin bawaan.
AUTH_ENABLED=true

# Akun admin dibuat otomatis saat database masih kosong.
# GANTI kata sandinya sebelum dipakai di luar mesin sendiri.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

JWT_SECRET_KEY=ganti-dengan-random-string-panjang
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
