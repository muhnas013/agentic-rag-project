# ============================================
# Agentic RAG — Environment Configuration
# Salin file ini menjadi .env lalu sesuaikan
# ============================================

APP_ENV=development
APP_NAME=Agentic RAG
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_DB=agentic_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:mysecretpassword@localhost:5432/agentic_rag

# User read-only khusus SQL Agent (PRD §18 - Database Security)
SQL_AGENT_DB_USER=rag_readonly
SQL_AGENT_DB_PASSWORD=readonlypassword
SQL_AGENT_DATABASE_URL=postgresql+psycopg://rag_readonly:readonlypassword@localhost:5432/agentic_rag
SQL_AGENT_ALLOWED_TABLES=chat_history,documents
SQL_AGENT_QUERY_TIMEOUT=10
SQL_AGENT_MAX_ROWS=100

# --- Provider AI ---------------------------------------------------------
# Ollama adalah target akhir sesuai PRD. Selama model lokal belum diunduh,
# LLM dilayani provider API yang OpenAI-compatible. Pindah kembali ke Ollama
# di Fase 3 cukup dengan mengubah dua variabel di bawah, tanpa ubah kode.
#
#   LLM_PROVIDER        : ollama | openai_compatible
#   EMBEDDING_PROVIDER  : ollama | openai_compatible | hash_stub
#
# hash_stub adalah embedding deterministik lokal khusus pengembangan: memakai
# hashing, bukan model, sehingga pipeline RAG (chunking -> simpan -> pencarian
# pgvector) bisa diuji tanpa model apa pun. Kualitas semantiknya rendah dan
# TIDAK boleh dipakai untuk menilai mutu retrieval.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Atria Dawn Preview - OpenAI-compatible, mendukung tool calling.
# Catatan: Atria TIDAK menyediakan endpoint /v1/embeddings, jadi provider ini
# hanya melayani LLM. Embedding tetap lewat Ollama (Fase 3) atau hash_stub.
LLM_API_BASE_URL=https://api.atria-asi.ai/v1
LLM_API_MODEL=Atria-Dawn-Preview
LLM_API_KEY=

# Diisi hanya bila EMBEDDING_PROVIDER=openai_compatible.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_MODEL=
EMBEDDING_API_KEY=

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://172.28.0.1:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192

# Percobaan ulang saat provider membalas 503/429, dengan jeda menaik.
LLM_MAX_RETRIES=8

# Dimensi harus cocok dengan embedding model (nomic-embed-text = 768)
EMBEDDING_DIM=768

# --- RAG ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=4

# Potongan yang skornya jauh di bawah potongan terbaik dibuang sebelum
# dikirim ke LLM. Ambangnya relatif (0.5 = setengah skor terbaik), bukan
# angka mati, karena tiap model embedding punya rentang skor sendiri.
# Isi 0 untuk mematikan penyaringan.
RAG_MIN_SCORE_RATIO=0.5

# --- File Upload (PRD §18 - File Upload Security) ---
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
MAX_UPLOAD_SIZE_MB=20
ALLOWED_DOC_EXTENSIONS=.pdf,.txt,.md
ALLOWED_IMAGE_EXTENSIONS=.png,.jpg,.jpeg,.webp

# --- OCR ---
OCR_LANG=en
OCR_USE_GPU=false

# --- Security ---
JWT_SECRET_KEY=ganti-dengan-random-string-panjang
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
